rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeMember(pantryId) {
      // Storage permits at most two distinct Firestore documents per evaluation.
      // The backend maintains memberUids atomically with active membership.
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/pantries/$(pantryId))
        && (!firestore.get(/databases/(default)/documents/pantries/$(pantryId)).data.keys().hasAny(['deletedAt'])
          || firestore.get(/databases/(default)/documents/pantries/$(pantryId)).data.deletedAt == null)
        && request.auth.uid in firestore.get(/databases/(default)/documents/pantries/$(pantryId)).data.memberUids;
    }

    function activeVariant(pantryId, variantId) {
      return firestore.exists(/databases/(default)/documents/pantries/$(pantryId)/variants/$(variantId))
        && (!firestore.get(/databases/(default)/documents/pantries/$(pantryId)/variants/$(variantId)).data.keys().hasAny(['deletedAt'])
          || firestore.get(/databases/(default)/documents/pantries/$(pantryId)/variants/$(variantId)).data.deletedAt == null);
      // Product deletion marks all its variants deleted in the same transaction.
    }

    function activeProduct(pantryId, productId) {
      return firestore.exists(/databases/(default)/documents/pantries/$(pantryId)/products/$(productId))
        && (!firestore.get(/databases/(default)/documents/pantries/$(pantryId)/products/$(productId)).data.keys().hasAny(['deletedAt'])
          || firestore.get(/databases/(default)/documents/pantries/$(pantryId)/products/$(productId)).data.deletedAt == null);
    }

    match /pantries/{pantryId}/products/{productId}/{fileName} {
      allow read: if activeMember(pantryId);
      allow create, update: if activeMember(pantryId)
        && activeProduct(pantryId, productId)
        && fileName == 'main.jpg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.productId == productId;
      // Brisanje privatnih fotografija obavljaju isključivo pouzdane backend
      // operacije (Admin SDK zaobilazi klijentska pravila).
      allow delete: if false;
    }

    match /pantries/{pantryId}/variants/{variantId}/{fileName} {
      allow read: if activeMember(pantryId) && activeVariant(pantryId, variantId);
      allow create, update: if activeMember(pantryId)
        && activeVariant(pantryId, variantId)
        && fileName == 'main.jpg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.variantId == variantId;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
